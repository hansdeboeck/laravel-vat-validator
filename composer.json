{
    "name": "hansdeboeck/laravel-vat-validator",
    "description": "EU VAT (BTW) validator for Laravel — VIES with automatic fallbacks (controleerbtwnummer.eu, btw-opzoeken.be), 24h cache, address parsing.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "vat", "btw", "vies", "validator", "belgium"],
    "authors": [
        {
            "name": "Hans De Boeck"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "HansDeBoeck\\VatValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HansDeBoeck\\VatValidator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HansDeBoeck\\VatValidator\\VatValidatorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
